# ──────────────────────────────────────────────────────────────
# Strong Tower Christian Ministry — environment variables
# Copy this file to .env.local and fill in the values.
# Every integration is configured here so the site stays portable.
# Nothing is hardcoded; swapping accounts is a values change, not a
# code change.
# ──────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://strongtowercm.org

# YouTube Data API v3 — live status and automatic sermon pull
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Resend — contact and prayer-request email delivery
RESEND_API_KEY=
RESEND_FROM=Strong Tower Website <noreply@strongtowercm.org>
CONTACT_TO_EMAIL=
PRAYER_TO_EMAIL=

# Newsletter — provider-agnostic (default: Resend Audiences)
NEWSLETTER_PROVIDER=resend
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# Giving — single swap-slot. Paste the church's giving URL here.
NEXT_PUBLIC_GIVING_URL=
