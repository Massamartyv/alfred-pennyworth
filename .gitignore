# Build artifacts
.next/
node_modules/
.turbo/
dist/
out/

# Python runtime
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Package locks (keep in client project repos, not here)
package-lock.json

# IDE
.vscode/
.idea/

# Claude Code internals (constitution, settings, hooks, agents and workflows kept under version control)
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/hooks/
!.claude/agents/
!.claude/workflows/
# Local Claude settings at any nesting depth (machine-specific, never shared)
**/.claude/settings.local.json

# Working directory (transient session files)
.working/

# Archive (contains embedded repos and large assets – local only)
Context/Archive/

# OAuth tokens (sensitive)
**/.tokens.json

# Python virtual environments
**/.venv/

# Embedded project repos (these have their own git repos)
**/nomad-express-web/
**/cwd-web/
**/cwd-proposal/
**/fountain-christian-center/
Templates/Website/nextjs-starter/
alfred-os/
Integrations/discord-setup-mcp/

# Personal projects (local-only)
Projects/

# Apps live in their own repositories (see Manual/genesis.md)
Apps/

# Secrets and personal data (never leave this machine)
Private/
Context/Spheres/System/Personal Finance/*.csv

# Prospecting data (PII lead lists and outreach queues, any venture)
Context/Spheres/System/Entrepreneurship/*/Growth/Prospecting/*.csv
Context/Spheres/System/Entrepreneurship/*/Growth/Prospecting/*.xlsx

# Transient venture scratch (large binaries, drafts, downloaded material)
**/Working Files/
Context/Spheres/System/Entrepreneurship/Library/

# Venture asset shelves (purchased packs, mockups, stock and call media – large binaries, local only)
Context/Spheres/System/Entrepreneurship/*/Creative/Asset Library/
Context/Spheres/System/Entrepreneurship/*/Operations/Clientele/**/*.m4a

# Personal social-media data exports and media dumps (PII, local-only).
# Full account archives (Instagram/Facebook/LinkedIn/TikTok) and Bitmoji
# packs live on disk only. Folder preserved via .gitkeep.
Context/Spheres/Soul/Social Development/*
!Context/Spheres/Soul/Social Development/.gitkeep
